{
  "name": "stockiq",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.10",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.1",
    "web-vitals": "^6.2.3",
    "zod": "^4.4.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prestart": "npm run gen:content",
    "start": "expo start --go",
    "android": "expo run:android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "validate:content": "tsx scripts/validate-content.ts",
    "test:validator": "tsx scripts/validate-content.ts tests/fixtures/broken-content --expect-failure",
    "gen:content": "tsx scripts/validate-content.ts && tsx scripts/generate-content-index.ts",
    "new:lesson": "tsx scripts/new-lesson.ts",
    "audit:sources": "tsx scripts/add-content-sources.ts && tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "preweb": "npm run gen:content",
    "preios": "npm run gen:content",
    "preandroid": "npm run gen:content",
    "gen:authoring-prompt": "tsx scripts/generate-authoring-prompt.ts",
    "test:sync-cycle": "tsx tests/sync-cycle.test.ts",
    "test:unit": "tsx --test tests/profile-migration.test.ts tests/dashboard-metrics.test.ts tests/art-motion.test.ts tests/narration-feedback.test.ts tests/content-quality.test.ts tests/achievements.test.ts tests/review.test.ts tests/hearts.test.ts tests/entitlement.test.ts tests/gamification.test.ts tests/advisor.test.ts tests/market.test.ts tests/paper.test.ts tests/leagues.test.ts tests/resume.test.ts tests/sync-server-owned.test.ts",
    "start:clear": "expo start --go --clear",
    "start:dev-client": "expo start --dev-client",
    "gen:speech": "tsx scripts/generate-speech.ts",
    "gen:voice-previews": "tsx scripts/generate-voice-previews.ts",
    "upload:speech": "tsx scripts/upload-speech-r2.ts",
    "art:apply-scenes": "tsx scripts/apply-scene-illustrations.ts",
    "art:optimize": "node scripts/optimize-lesson-art.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\""
  },
  "private": true
}
