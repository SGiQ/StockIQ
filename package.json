{
  "name": "stockiq",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.9",
    "expo-apple-authentication": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prestart": "npm run gen:content",
    "start": "expo start --go",
    "android": "expo start --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "validate:content": "tsx scripts/validate-content.ts",
    "test:validator": "tsx scripts/validate-content.ts tests/fixtures/broken-content --expect-failure",
    "gen:content": "tsx scripts/validate-content.ts && tsx scripts/generate-content-index.ts",
    "new:lesson": "tsx scripts/new-lesson.ts",
    "typecheck": "tsc --noEmit",
    "preweb": "npm run gen:content",
    "preios": "npm run gen:content",
    "preandroid": "npm run gen:content",
    "gen:authoring-prompt": "tsx scripts/generate-authoring-prompt.ts",
    "test:sync-cycle": "tsx tests/sync-cycle.test.ts",
    "start:clear": "expo start --go --clear",
    "start:dev-client": "expo start --dev-client"
  },
  "private": true
}
