# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Deployment URLs and any local secrets. Every .env variant is ignored
# (including .env.production, which the older `.env` + `.env*.local` pair
# missed); only the placeholder-filled example is tracked.
.env*
!.env.example
.vercel

# Visual reference from other apps — copyrighted, must never be committed.
docs/reference/

# Generated narration is deployed to Cloudflare R2, not stored in Git.
/public/speech/
