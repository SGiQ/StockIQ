{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "//": [
        "The build to install on your own iPhone.",
        "",
        "developmentClient bundles the dev menu and lets the app load JS from",
        "your machine, so you edit and reload without rebuilding. You only",
        "rebuild when native code changes — adding a package with a native",
        "module, or changing app.json's plugins or entitlements.",
        "",
        "distribution 'internal' means installed by link rather than through",
        "TestFlight, which needs your device registered against an Apple",
        "Developer account. See docs/deployment.md."
      ],
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_SYNC_URL": "https://stockiq-sync-production.up.railway.app",
        "EXPO_PUBLIC_ASK_PROXY_URL": "https://stockiq-ask.sgiqbusiness.workers.dev",
        "EXPO_PUBLIC_SPEECH_URL": "https://stockiq-narration.sgiqbusiness.workers.dev",
        "EXPO_PUBLIC_MARKET_URL": "https://stockiq-market.sgiqbusiness.workers.dev",
        "EXPO_PUBLIC_SENTRY_DSN": "https://778e192533e30326b8aa89af8959dae6@o4509897180446720.ingest.us.sentry.io/4511905965015040",
        "EXPO_PUBLIC_SITE_URL": "https://stockiq-delta.vercel.app"
      }
    },
    "preview": {
      "//": "A release build, no dev menu — what the app actually feels like.",
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_SYNC_URL": "https://stockiq-sync-production.up.railway.app",
        "EXPO_PUBLIC_ASK_PROXY_URL": "https://stockiq-ask.sgiqbusiness.workers.dev",
        "EXPO_PUBLIC_SPEECH_URL": "https://stockiq-narration.sgiqbusiness.workers.dev",
        "EXPO_PUBLIC_MARKET_URL": "https://stockiq-market.sgiqbusiness.workers.dev",
        "EXPO_PUBLIC_SENTRY_DSN": "https://778e192533e30326b8aa89af8959dae6@o4509897180446720.ingest.us.sentry.io/4511905965015040",
        "EXPO_PUBLIC_SITE_URL": "https://stockiq-delta.vercel.app"
      }
    },
    "production": {
      "//": [
        "The ASK Worker is deployed and holds the Anthropic key server-side, so",
        "the app calls the proxy rather than asking for a bring-your-own key.",
        "",
        "Only public endpoint URLs belong in these env blocks — they are inlined",
        "into the bundle and readable by anyone with the app. The Anthropic key",
        "is NOT here; it is a Cloudflare secret on the Worker."
      ],
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_SYNC_URL": "https://stockiq-sync-production.up.railway.app",
        "EXPO_PUBLIC_ASK_PROXY_URL": "https://stockiq-ask.sgiqbusiness.workers.dev",
        "EXPO_PUBLIC_SPEECH_URL": "https://stockiq-narration.sgiqbusiness.workers.dev",
        "EXPO_PUBLIC_MARKET_URL": "https://stockiq-market.sgiqbusiness.workers.dev",
        "EXPO_PUBLIC_SENTRY_DSN": "https://778e192533e30326b8aa89af8959dae6@o4509897180446720.ingest.us.sentry.io/4511905965015040",
        "EXPO_PUBLIC_SITE_URL": "https://stockiq-delta.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
