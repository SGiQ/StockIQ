{
  "name": "stockiq-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StockiQ sync service — Postgres-backed last-write-wins record sync.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/rateLimit.test.ts test/protocol.test.ts test/telemetry.test.ts test/leagues.test.ts",
    "test:sync": "node test/sync.test.mjs",
    "test:pairing": "node test/pairing.test.mjs",
    "test:apple": "tsx test/apple.test.mjs",
    "test:apple-accounts": "node test/apple-accounts.test.mjs",
    "test:email": "node test/email.test.mjs",
    "test:telemetry": "tsx --test test/telemetry.test.ts",
    "test:leagues": "tsx --test test/leagues.test.ts",
    "check:email": "tsx src/check-email.ts",
    "test:delete": "node test/delete.test.mjs"
  },
  "dependencies": {
    "jose": "^6.2.5",
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
