{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run gen:content && npx expo export --platform web --output-dir dist",
  "outputDirectory": "dist",
  "framework": null,
  "build": {
    "env": {
      "EXPO_PUBLIC_SYNC_URL": "https://stockiq-sync-production.up.railway.app",
      "EXPO_PUBLIC_ASK_PROXY_URL": "",
      "EXPO_PUBLIC_SPEECH_URL": "https://stockiq-narration.sgiqbusiness.workers.dev"
    }
  },
  "rewrites": [
    {
      "source": "/((?!_expo/|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "cache-control", "value": "no-cache" }]
    }
  ]
}
