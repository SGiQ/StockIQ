# Copy to .env and fill in. Values are inlined into the app bundle at build
# time and are readable by anyone with the app, so ONLY public endpoint URLs
# belong here — never an API key or token.

# Railway sync service. Leave empty to run local-only with no network calls.
EXPO_PUBLIC_SYNC_URL=

# Cloudflare Worker ASK proxy. Leave empty to fall back to bring-your-own-key.
EXPO_PUBLIC_ASK_PROXY_URL=
