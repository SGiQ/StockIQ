# Local development. Git-ignored.
# Only PUBLIC endpoint URLs belong here — EXPO_PUBLIC_* values are inlined
# into the bundle and readable by anyone with the app. Never a key.
EXPO_PUBLIC_SYNC_URL=https://stockiq-sync-production.up.railway.app

# Cloudflare Worker that proxies ASK so the Anthropic key stays server-side.
# Set = the app uses the proxy; empty = it falls back to bring-your-own-key.
EXPO_PUBLIC_ASK_PROXY_URL=https://stockiq-ask.sgiqbusiness.workers.dev

# Cloudflare Worker that proxies Finnhub quotes so the market-data key stays
# server-side. Set = real delayed quotes; empty = deterministic placeholder
# prices (the watchlist shows a "placeholder prices" banner).
EXPO_PUBLIC_MARKET_URL=https://stockiq-market.sgiqbusiness.workers.dev

# Public Cloudflare R2 origin for generated narration clips.
EXPO_PUBLIC_SPEECH_URL=https://stockiq-narration.sgiqbusiness.workers.dev

# Public website origin. Native builds use it to open the legal pages, which
# live in the web deploy's public/legal/. Web ignores it (uses relative paths).
# Defaults to the production deploy if unset.
EXPO_PUBLIC_SITE_URL=https://stockiq-delta.vercel.app

# Build-time only. Used by `npm run gen:speech`; never included in the app.
# Never prefix this with EXPO_PUBLIC_.
OPENAI_API_KEY=
